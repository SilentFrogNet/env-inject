{
  "name": "@silentfrog/env-inject",
  "version": "1.1.0",
  "description": "Tool to inject environment variables into your project build",
  "keywords": [
    "env",
    "environment",
    "runtime",
    "vite",
    "react",
    "create-react-app",
    "docker",
    "nginx"
  ],
  "homepage": "https://github.com/SilentFrogNet/env-inject#readme",
  "bugs": {
    "url": "https://github.com/SilentFrogNet/env-inject/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentFrogNet/env-inject.git"
  },
  "license": "MIT",
  "author": "Ilario Dal Grande",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "env-inject": "./cli.js"
  },
  "files": [
    "cli.js",
    "index.js",
    "index.d.ts",
    "client.d.ts",
    "utils"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
